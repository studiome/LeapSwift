{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/leapswift\/handmodel"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandModel"},"abstract":[{"type":"text","text":"How LeapSwift represents a tracked hand, from the frame down to individual bones."}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Tracking data arrives as a nested hierarchy of value types. Each level narrows"},{"text":" ","type":"text"},{"type":"text","text":"the scope: a frame holds hands, a hand holds a palm and five fingers, and each"},{"text":" ","type":"text"},{"type":"text","text":"finger holds four bones."}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["HandFrame","├── frameId, timestamp, frameRate","└── hands: [Hand]                    \/\/ 0, 1, or 2","    ├── id, type, confidence, visibleTime","    ├── pinchStrength, pinchDistance","    ├── grabStrength, grabAngle","    ├── palm: Palm                   \/\/ position, normal, direction, orientation","    ├── arm: Bone                    \/\/ forearm","    └── thumb, index, middle, ring, pinky: Finger","        ├── id, isExtended","        └── metacarpal, proximal, intermediate, distal: Bone","            └── previousJoint, nextJoint, width, rotation"]},{"level":3,"text":"Frames","type":"heading","anchor":"Frames"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/frameId","type":"reference"},{"text":" increases monotonically while a connection is open, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/timestamp"},{"type":"text","text":" is in microseconds on the service’s clock — the same"},{"type":"text","text":" "},{"type":"text","text":"timebase as "},{"type":"codeVoice","code":"LeapGetNow()"},{"type":"text","text":". Use the timestamp rather than your own wall clock"},{"type":"text","text":" "},{"type":"text","text":"when interpolating between frames or measuring velocity yourself."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/frameRate"},{"text":" reports the service’s current tracking rate in hertz,","type":"text"},{"text":" ","type":"text"},{"text":"which varies with device model, USB bandwidth, and system load.","type":"text"}]},{"level":3,"text":"Hands","type":"heading","anchor":"Hands"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/id","type":"reference","isActive":true},{"type":"text","text":" is stable for as long as the hand remains tracked. If the hand"},{"type":"text","text":" "},{"type":"text","text":"leaves the field of view and returns, it comes back with a new id — so treat a"},{"type":"text","text":" "},{"type":"text","text":"change in id as a new hand, not a continuation."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/visibleTime","isActive":true},{"text":" accumulates in microseconds for the life of that id, which","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"makes it a convenient way to ignore hands that have only just appeared and may"},{"type":"text","text":" "},{"type":"text","text":"still be settling:"}]},{"syntax":"swift","code":["guard hand.visibleTime > 200_000 else { continue }  \/\/ tracked > 200 ms"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/fingers","isActive":true,"type":"reference"},{"text":" returns the five fingers in a fixed order — thumb, index,","type":"text"},{"text":" ","type":"text"},{"text":"middle, ring, pinky — matching the named properties. Iterate it when you want","type":"text"},{"text":" ","type":"text"},{"text":"uniform treatment, and use the named properties otherwise.","type":"text"}]},{"anchor":"The-Palm","level":3,"text":"The Palm","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm","isActive":true},{"text":" describes the hand’s overall pose. Two vectors define its facing:","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/normal"},{"type":"text","text":" points out through the palm surface, and "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/direction","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"points from the palm toward the fingers. Together with "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/orientation","isActive":true,"type":"reference"},{"type":"text","text":" they"},{"type":"text","text":" "},{"type":"text","text":"give you a full frame of reference."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Is the hand facing up (palm toward the ceiling)?","let facingUp = simd_dot(hand.palm.normal, SIMD3<Float>(0, 1, 0)) > 0.8"]},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/position","isActive":true},{"text":" is the raw center of the palm; ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/stabilizedPosition"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"time-filtered variant that trades a little latency for much less jitter. Prefer"},{"type":"text","text":" "},{"type":"text","text":"the stabilized position for cursors and UI hit-testing, and the raw position for"},{"type":"text","text":" "},{"type":"text","text":"physical simulation."}],"type":"paragraph"},{"text":"Fingers and Bones","level":3,"anchor":"Fingers-and-Bones","type":"heading"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger"},{"type":"text","text":" exposes its four bones from the wrist outward, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/bones"},{"type":"text","text":" returns them in that order."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/tipPosition","type":"reference"},{"text":" is a shortcut for the distal bone’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/nextJoint","type":"reference","isActive":true},{"text":" — the fingertip.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"In the Ultraleap skeletal model the thumb has no true metacarpal bone."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/metacarpal"},{"type":"text","text":" is still present for the thumb, but it is zero-length,"},{"type":"text","text":" "},{"type":"text","text":"so "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/length"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"0"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/center","type":"reference"},{"type":"text","text":" coincides with both joints."},{"type":"text","text":" "},{"type":"text","text":"Skip it when drawing, or you will render a degenerate segment."}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone","isActive":true,"type":"reference"},{"text":" is a segment between two joints: ","type":"text"},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/previousJoint","isActive":true,"type":"reference"},{"text":" toward the","type":"text"},{"text":" ","type":"text"},{"text":"wrist, ","type":"text"},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/nextJoint","isActive":true,"type":"reference"},{"text":" toward the fingertip. ","type":"text"},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/center","isActive":true,"type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/length","isActive":true,"type":"reference"},{"text":" are derived from those, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/width"},{"text":" estimates the flesh","type":"text"},{"text":" ","type":"text"},{"text":"around the bone in millimeters — enough to size a capsule mesh.","type":"text"}]},{"code":["for finger in hand.fingers {","    for bone in finger.bones where bone.length > 0 {","        drawCapsule(from: bone.previousJoint,","                    to: bone.nextJoint,","                    radius: bone.width * 0.5,","                    rotation: bone.rotation)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/isExtended","type":"reference"},{"text":" reports whether the finger is roughly straight, which is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the simplest basis for counting fingers or recognizing static poses:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let extended = hand.fingers.filter(\\.isExtended).count"]}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"LeapSwift"}],"title":"The Hand Model"},"hierarchy":{"paths":[["doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm"],"title":"Related Documentation","anchor":"Related-Documentation"},{"title":"Hand Data","anchor":"Hand-Data","identifiers":["doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandType","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone"],"generated":true}],"references":{"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Bone/width":{"role":"symbol","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/width","title":"width","kind":"symbol","abstract":[{"text":"Average width of flesh around the bone in millimeters.","type":"text"}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"width","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Float","kind":"typeIdentifier","preciseIdentifier":"s:Sf"}],"url":"\/documentation\/leapswift\/bone\/width","type":"topic"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/HandFrame/frameRate":{"title":"frameRate","url":"\/documentation\/leapswift\/handframe\/framerate","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"frameRate"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sf","text":"Float","kind":"typeIdentifier"}],"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/frameRate","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Current tracking frame rate in hertz."}]},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Palm/stabilizedPosition":{"type":"topic","kind":"symbol","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/stabilizedPosition","url":"\/documentation\/leapswift\/palm\/stabilizedposition","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"stabilizedPosition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:9LeapSwift7Vector3a","text":"Vector3"}],"title":"stabilizedPosition","abstract":[{"text":"Time-filtered, stabilized palm position (suitable for 2D UI interaction).","type":"text"}]},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Palm":{"role":"symbol","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm","title":"Palm","kind":"symbol","abstract":[{"type":"text","text":"Data about the palm of the hand."}],"navigatorTitle":[{"text":"Palm","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Palm"}],"url":"\/documentation\/leapswift\/palm","type":"topic"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Bone/length":{"role":"symbol","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/length","title":"length","kind":"symbol","abstract":[{"text":"Length of the bone in millimeters.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"length"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"}],"url":"\/documentation\/leapswift\/bone\/length","type":"topic"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Palm/direction":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"direction","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:9LeapSwift7Vector3a","text":"Vector3"}],"url":"\/documentation\/leapswift\/palm\/direction","title":"direction","type":"topic","abstract":[{"type":"text","text":"Unit vector pointing from palm toward the fingers."}],"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/direction","role":"symbol","kind":"symbol"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Bone/center":{"role":"symbol","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/center","title":"center","kind":"symbol","abstract":[{"type":"text","text":"Computed center of the bone."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"center","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Vector3","kind":"typeIdentifier","preciseIdentifier":"s:9LeapSwift7Vector3a"}],"url":"\/documentation\/leapswift\/bone\/center","type":"topic"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/HandType":{"role":"symbol","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandType","title":"HandType","kind":"symbol","abstract":[{"type":"text","text":"Whether the hand is the left or right hand."}],"navigatorTitle":[{"kind":"identifier","text":"HandType"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"HandType"}],"url":"\/documentation\/leapswift\/handtype","type":"topic"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift":{"abstract":[{"text":"Track hands in three dimensions with Ultraleap hardware, using a Swift-native","type":"text"},{"text":" ","type":"text"},{"text":"async\/await API.","type":"text"}],"title":"LeapSwift","url":"\/documentation\/leapswift","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Finger":{"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Finger"}],"navigatorTitle":[{"text":"Finger","kind":"identifier"}],"title":"Finger","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger","url":"\/documentation\/leapswift\/finger","kind":"symbol","type":"topic","role":"symbol","abstract":[{"text":"A tracked finger with its four bones.","type":"text"}]},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Finger/metacarpal":{"kind":"symbol","url":"\/documentation\/leapswift\/finger\/metacarpal","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"metacarpal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bone","kind":"typeIdentifier","preciseIdentifier":"s:9LeapSwift4BoneV"}],"title":"metacarpal","role":"symbol","abstract":[{"type":"text","text":"The metacarpal bone (zero-length for the thumb in the Ultraleap model)."}],"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/metacarpal","type":"topic"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Hand/id":{"type":"topic","kind":"symbol","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/id","url":"\/documentation\/leapswift\/hand\/id","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt32V","text":"UInt32"}],"title":"id","abstract":[{"text":"Unique identifier for this hand across frames (stable while the hand is tracked).","type":"text"}]},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Palm/orientation":{"kind":"symbol","url":"\/documentation\/leapswift\/palm\/orientation","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"orientation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Quaternion","preciseIdentifier":"s:9LeapSwift10Quaterniona"}],"title":"orientation","role":"symbol","abstract":[{"text":"Quaternion representing the palm’s orientation.","type":"text"}],"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/orientation","type":"topic"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/HandFrame/timestamp":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"timestamp"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int64V","text":"Int64"}],"title":"timestamp","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/timestamp","url":"\/documentation\/leapswift\/handframe\/timestamp","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The timestamp in microseconds (relative to LeapGetNow())."}]},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Hand":{"role":"symbol","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand","title":"Hand","kind":"symbol","abstract":[{"type":"text","text":"A fully tracked hand with all fingers, palm, and arm data."}],"navigatorTitle":[{"text":"Hand","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hand"}],"url":"\/documentation\/leapswift\/hand","type":"topic"},"doc://org.studiomexx.LeapSwift/documentation/Lea