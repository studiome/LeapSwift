{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandModel"},"hierarchy":{"paths":[["doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/leapswift\/handmodel"]}],"metadata":{"roleHeading":"Article","title":"The Hand Model","modules":[{"name":"LeapSwift"}],"role":"article"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm"],"anchor":"Related-Documentation"},{"title":"Hand Data","identifiers":["doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandType","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone"],"anchor":"Hand-Data","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"Tracking data arrives as a nested hierarchy of value types. Each level narrows","type":"text"},{"text":" ","type":"text"},{"text":"the scope: a frame holds hands, a hand holds a palm and five fingers, and each","type":"text"},{"text":" ","type":"text"},{"text":"finger holds four bones.","type":"text"}],"type":"paragraph"},{"code":["HandFrame","├── frameId, timestamp, frameRate","└── hands: [Hand]                    \/\/ 0, 1, or 2","    ├── id, type, confidence, visibleTime","    ├── pinchStrength, pinchDistance","    ├── grabStrength, grabAngle","    ├── palm: Palm                   \/\/ position, normal, direction, orientation","    ├── arm: Bone                    \/\/ forearm","    └── thumb, index, middle, ring, pinky: Finger","        ├── id, isExtended","        └── metacarpal, proximal, intermediate, distal: Bone","            └── previousJoint, nextJoint, width, rotation"],"type":"codeListing","syntax":null},{"type":"heading","text":"Frames","level":3,"anchor":"Frames"},{"inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/frameId","isActive":true,"type":"reference"},{"text":" increases monotonically while a connection is open, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/timestamp","isActive":true,"type":"reference"},{"type":"text","text":" is in microseconds on the service’s clock — the same"},{"type":"text","text":" "},{"type":"text","text":"timebase as "},{"type":"codeVoice","code":"LeapGetNow()"},{"type":"text","text":". Use the timestamp rather than your own wall clock"},{"type":"text","text":" "},{"type":"text","text":"when interpolating between frames or measuring velocity yourself."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/frameRate","type":"reference","isActive":true},{"type":"text","text":" reports the service’s current tracking rate in hertz,"},{"type":"text","text":" "},{"type":"text","text":"which varies with device model, USB bandwidth, and system load."}],"type":"paragraph"},{"level":3,"anchor":"Hands","type":"heading","text":"Hands"},{"inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/id","isActive":true,"type":"reference"},{"text":" is stable for as long as the hand remains tracked. If the hand","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"leaves the field of view and returns, it comes back with a new id — so treat a"},{"type":"text","text":" "},{"type":"text","text":"change in id as a new hand, not a continuation."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/visibleTime","isActive":true},{"type":"text","text":" accumulates in microseconds for the life of that id, which"},{"type":"text","text":" "},{"type":"text","text":"makes it a convenient way to ignore hands that have only just appeared and may"},{"type":"text","text":" "},{"type":"text","text":"still be settling:"}],"type":"paragraph"},{"code":["guard hand.visibleTime > 200_000 else { continue }  \/\/ tracked > 200 ms"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/fingers"},{"type":"text","text":" returns the five fingers in a fixed order — thumb, index,"},{"type":"text","text":" "},{"type":"text","text":"middle, ring, pinky — matching the named properties. Iterate it when you want"},{"type":"text","text":" "},{"type":"text","text":"uniform treatment, and use the named properties otherwise."}],"type":"paragraph"},{"level":3,"anchor":"The-Palm","type":"heading","text":"The Palm"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm","type":"reference","isActive":true},{"type":"text","text":" describes the hand’s overall pose. Two vectors define its facing:"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/normal","type":"reference","isActive":true},{"type":"text","text":" points out through the palm surface, and "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/direction","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"points from the palm toward the fingers. Together with "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/orientation","type":"reference","isActive":true},{"type":"text","text":" they"},{"type":"text","text":" "},{"type":"text","text":"give you a full frame of reference."}]},{"code":["\/\/ Is the hand facing up (palm toward the ceiling)?","let facingUp = simd_dot(hand.palm.normal, SIMD3<Float>(0, 1, 0)) > 0.8"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/position"},{"type":"text","text":" is the raw center of the palm; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/stabilizedPosition"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"time-filtered variant that trades a little latency for much less jitter. Prefer"},{"type":"text","text":" "},{"type":"text","text":"the stabilized position for cursors and UI hit-testing, and the raw position for"},{"type":"text","text":" "},{"type":"text","text":"physical simulation."}]},{"type":"heading","level":3,"anchor":"Fingers-and-Bones","text":"Fingers and Bones"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger"},{"type":"text","text":" exposes its four bones from the wrist outward, and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/bones"},{"type":"text","text":" returns them in that order."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/tipPosition"},{"type":"text","text":" is a shortcut for the distal bone’s"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/nextJoint"},{"type":"text","text":" — the fingertip."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the Ultraleap skeletal model the thumb has no true metacarpal bone."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/metacarpal","isActive":true},{"type":"text","text":" is still present for the thumb, but it is zero-length,"},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/length","isActive":true},{"type":"text","text":" returns "},{"code":"0","type":"codeVoice"},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/center","isActive":true},{"type":"text","text":" coincides with both joints."},{"type":"text","text":" "},{"type":"text","text":"Skip it when drawing, or you will render a degenerate segment."}]}],"type":"aside","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone","type":"reference","isActive":true},{"type":"text","text":" is a segment between two joints: "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/previousJoint","type":"reference","isActive":true},{"type":"text","text":" toward the"},{"type":"text","text":" "},{"type":"text","text":"wrist, "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/nextJoint","type":"reference","isActive":true},{"type":"text","text":" toward the fingertip. "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/center","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/length","type":"reference","isActive":true},{"text":" are derived from those, and ","type":"text"},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/width","type":"reference","isActive":true},{"type":"text","text":" estimates the flesh"},{"text":" ","type":"text"},{"type":"text","text":"around the bone in millimeters — enough to size a capsule mesh."}]},{"code":["for finger in hand.fingers {","    for bone in finger.bones where bone.length > 0 {","        drawCapsule(from: bone.previousJoint,","                    to: bone.nextJoint,","                    radius: bone.width * 0.5,","                    rotation: bone.rotation)","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/isExtended","type":"reference","isActive":true},{"type":"text","text":" reports whether the finger is roughly straight, which is"},{"type":"text","text":" "},{"type":"text","text":"the simplest basis for counting fingers or recognizing static poses:"}]},{"syntax":"swift","code":["let extended = hand.fingers.filter(\\.isExtended).count"],"type":"codeListing"}]}],"sections":[],"abstract":[{"type":"text","text":"How LeapSwift represents a tracked hand, from the frame down to individual bones."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","references":{"doc://org.studiomexx.LeapSwift/documentation/LeapSwift":{"role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Track hands in three dimensions with Ultraleap hardware, using a Swift-native"},{"type":"text","text":" "},{"type":"text","text":"async\/await API."}],"type":"topic","title":"LeapSwift","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift","url":"\/documentation\/leapswift"},"doc://org.studiomexx.LeapSwift/documentation/Le