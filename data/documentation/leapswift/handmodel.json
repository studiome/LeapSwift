{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"title":"The Hand Model","roleHeading":"Article","role":"article","modules":[{"name":"LeapSwift"}]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"Tracking data arrives as a nested hierarchy of value types. Each level narrows","type":"text"},{"text":" ","type":"text"},{"text":"the scope: a frame holds hands, a hand holds a palm and five fingers, and each","type":"text"},{"text":" ","type":"text"},{"text":"finger holds four bones.","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["HandFrame","├── frameId, timestamp, frameRate","└── hands: [Hand]                    \/\/ 0, 1, or 2","    ├── id, type, confidence, visibleTime","    ├── pinchStrength, pinchDistance","    ├── grabStrength, grabAngle","    ├── palm: Palm                   \/\/ position, normal, direction, orientation","    ├── arm: Bone                    \/\/ forearm","    └── thumb, index, middle, ring, pinky: Finger","        ├── id, isExtended","        └── metacarpal, proximal, intermediate, distal: Bone","            └── previousJoint, nextJoint, width, rotation"]},{"anchor":"Frames","type":"heading","level":3,"text":"Frames"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/frameId"},{"text":" increases monotonically while a connection is open, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/timestamp"},{"text":" is in microseconds on the service’s clock — the same","type":"text"},{"text":" ","type":"text"},{"text":"timebase as ","type":"text"},{"type":"codeVoice","code":"LeapGetNow()"},{"text":". Use the timestamp rather than your own wall clock","type":"text"},{"text":" ","type":"text"},{"text":"when interpolating between frames or measuring velocity yourself.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/frameRate"},{"text":" reports the service’s current tracking rate in hertz,","type":"text"},{"text":" ","type":"text"},{"text":"which varies with device model, USB bandwidth, and system load.","type":"text"}],"type":"paragraph"},{"anchor":"Hands","type":"heading","level":3,"text":"Hands"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/id"},{"text":" is stable for as long as the hand remains tracked. If the hand","type":"text"},{"text":" ","type":"text"},{"text":"leaves the field of view and returns, it comes back with a new id — so treat a","type":"text"},{"text":" ","type":"text"},{"text":"change in id as a new hand, not a continuation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/visibleTime"},{"text":" accumulates in microseconds for the life of that id, which","type":"text"},{"text":" ","type":"text"},{"text":"makes it a convenient way to ignore hands that have only just appeared and may","type":"text"},{"text":" ","type":"text"},{"text":"still be settling:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["guard hand.visibleTime > 200_000 else { continue }  \/\/ tracked > 200 ms"]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/fingers"},{"text":" returns the five fingers in a fixed order — thumb, index,","type":"text"},{"text":" ","type":"text"},{"text":"middle, ring, pinky — matching the named properties. Iterate it when you want","type":"text"},{"text":" ","type":"text"},{"text":"uniform treatment, and use the named properties otherwise.","type":"text"}],"type":"paragraph"},{"anchor":"The-Palm","type":"heading","level":3,"text":"The Palm"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm"},{"text":" describes the hand’s overall pose. Two vectors define its facing:","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/normal"},{"text":" points out through the palm surface, and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/direction"},{"text":" ","type":"text"},{"text":"points from the palm toward the fingers. Together with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/orientation"},{"text":" they","type":"text"},{"text":" ","type":"text"},{"text":"give you a full frame of reference.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Is the hand facing up (palm toward the ceiling)?","let facingUp = simd_dot(hand.palm.normal, SIMD3<Float>(0, 1, 0)) > 0.8"]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/position"},{"text":" is the raw center of the palm; ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/stabilizedPosition"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"time-filtered variant that trades a little latency for much less jitter. Prefer","type":"text"},{"text":" ","type":"text"},{"text":"the stabilized position for cursors and UI hit-testing, and the raw position for","type":"text"},{"text":" ","type":"text"},{"text":"physical simulation.","type":"text"}],"type":"paragraph"},{"anchor":"Fingers-and-Bones","type":"heading","level":3,"text":"Fingers and Bones"},{"inlineContent":[{"text":"Each ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger"},{"text":" exposes its four bones from the wrist outward, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/bones"},{"text":" returns them in that order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/tipPosition"},{"text":" is a shortcut for the distal bone’s","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/nextJoint"},{"text":" — the fingertip.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the Ultraleap skeletal model the thumb has no true metacarpal bone."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/metacarpal"},{"type":"text","text":" is still present for the thumb, but it is zero-length,"},{"type":"text","text":" "},{"type":"text","text":"so "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/length"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"0"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/center"},{"type":"text","text":" coincides with both joints."},{"type":"text","text":" "},{"type":"text","text":"Skip it when drawing, or you will render a degenerate segment."}]}]},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone"},{"text":" is a segment between two joints: ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/previousJoint"},{"text":" toward the","type":"text"},{"text":" ","type":"text"},{"text":"wrist, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/nextJoint"},{"text":" toward the fingertip. ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/center"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/length"},{"text":" are derived from those, and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/width"},{"text":" estimates the flesh","type":"text"},{"text":" ","type":"text"},{"text":"around the bone in millimeters — enough to size a capsule mesh.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["for finger in hand.fingers {","    for bone in finger.bones where bone.length > 0 {","        drawCapsule(from: bone.previousJoint,","                    to: bone.nextJoint,","                    radius: bone.width * 0.5,","                    rotation: bone.rotation)","    }","}"]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/isExtended"},{"text":" reports whether the finger is roughly straight, which is","type":"text"},{"text":" ","type":"text"},{"text":"the simplest basis for counting fingers or recognizing static poses:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let extended = hand.fingers.filter(\\.isExtended).count"]}]}],"variants":[{"paths":["\/documentation\/leapswift\/handmodel"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandType","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger","doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone"],"anchor":"Hand-Data","title":"Hand Data","generated":true}],"abstract":[{"type":"text","text":"How LeapSwift represents a tracked hand, from the frame down to individual bones."}],"identifier":{"url":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandModel","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift"]]},"references":{"doc://org.studiomexx.LeapSwift/documentation/LeapSwift":{"url":"\/documentation\/leapswift","abstract":[{"type":"text","text":"Track hands in three dimensions with Ultraleap hardware, using a Swift-native"},{"type":"text","text":" "},{"type":"text","text":"async\/await API."}],"type":"topic","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift","title":"LeapSwift","role":"collection","kind":"symbol"},"doc://org.studiomexx.LeapSwift/documentation/Le