alm in millimeters from the device origin."}]},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Hand/fingers":{"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fingers","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:9LeapSwift6FingerV","text":"Finger","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"fingers","abstract":[{"text":"All five fingers in order: thumb, index, middle, ring, pinky.","type":"text"}],"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/fingers","url":"\/documentation\/leapswift\/hand\/fingers","kind":"symbol","role":"symbol"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Finger/bones":{"type":"topic","kind":"symbol","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/bones","url":"\/documentation\/leapswift\/finger\/bones","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"bones"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Bone","preciseIdentifier":"s:9LeapSwift4BoneV"},{"kind":"text","text":"]"}],"title":"bones","abstract":[{"type":"text","text":"All four bones in order: metacarpal → proximal → intermediate → distal."}]},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Palm/normal":{"type":"topic","url":"\/documentation\/leapswift\/palm\/normal","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"normal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:9LeapSwift7Vector3a","text":"Vector3"}],"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/normal","title":"normal","abstract":[{"type":"text","text":"Normal vector pointing out of the palm surface."}],"kind":"symbol","role":"symbol"},"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Finger/tipPosition":{"type":"topic","kind":"symbol","