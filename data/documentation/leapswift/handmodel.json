[Hand]                    \/\/ 0, 1, or 2","    ├── id, type, confidence, visibleTime","    ├── pinchStrength, pinchDistance","    ├── grabStrength, grabAngle","    ├── palm: Palm                   \/\/ position, normal, direction, orientation","    ├── arm: Bone                    \/\/ forearm","    └── thumb, index, middle, ring, pinky: Finger","        ├── id, isExtended","        └── metacarpal, proximal, intermediate, distal: Bone","            └── previousJoint, nextJoint, width, rotation"],"syntax":null},{"type":"heading","anchor":"Frames","level":3,"text":"Frames"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/frameId","isActive":true,"type":"reference"},{"text":" increases monotonically while a connection is open, and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/timestamp","isActive":true,"type":"reference"},{"text":" is in microseconds on the service’s clock — the same","type":"text"},{"text":" ","type":"text"},{"text":"timebase as ","type":"text"},{"type":"codeVoice","code":"LeapGetNow()"},{"text":". Use the timestamp rather than your own wall clock","type":"text"},{"text":" ","type":"text"},{"text":"when interpolating between frames or measuring velocity yourself.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandFrame\/frameRate","isActive":true,"type":"reference"},{"text":" reports the service’s current tracking rate in hertz,","type":"text"},{"text":" ","type":"text"},{"text":"which varies with device model, USB bandwidth, and system load.","type":"text"}]},{"type":"heading","anchor":"Hands","level":3,"text":"Hands"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/id","isActive":true,"type":"reference"},{"text":" is stable for as long as the hand remains tracked. If the hand","type":"text"},{"text":" ","type":"text"},{"text":"leaves the field of view and returns, it comes back with a new id — so treat a","type":"text"},{"text":" ","type":"text"},{"text":"change in id as a new hand, not a continuation.","type":"text"}]},{"inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/visibleTime","isActive":true,"type":"reference"},{"type":"text","text":" accumulates in microseconds for the life of that id, which"},{"type":"text","text":" "},{"type":"text","text":"makes it a convenient way to ignore hands that have only just appeared and may"},{"type":"text","text":" "},{"type":"text","text":"still be settling:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["guard hand.visibleTime > 200_000 else { continue }  \/\/ tracked > 200 ms"]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/fingers"},{"type":"text","text":" returns the five fingers in a fixed order — thumb, index,"},{"type":"text","text":" "},{"type":"text","text":"middle, ring, pinky — matching the named properties. Iterate it when you want"},{"type":"text","text":" "},{"type":"text","text":"uniform treatment, and use the named properties otherwise."}],"type":"paragraph"},{"anchor":"The-Palm","level":3,"type":"heading","text":"The Palm"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm","type":"reference"},{"type":"text","text":" describes the hand’s overall pose. Two vectors define its facing:"},{"type":"text","text":" "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/normal","isActive":true,"type":"reference"},{"type":"text","text":" points out through the palm surface, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/direction"},{"type":"text","text":" "},{"type":"text","text":"points from the palm toward the fingers. Together with "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/orientation","isActive":true,"type":"reference"},{"text":" they","type":"text"},{"text":" ","type":"text"},{"text":"give you a full frame of reference.","type":"text"}]},{"type":"codeListing","code":["\/\/ Is the hand facing up (palm toward the ceiling)?","let facingUp = simd_dot(hand.palm.normal, SIMD3<Float>(0, 1, 0)) > 0.8"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/position","isActive":true,"type":"reference"},{"text":" is the raw center of the palm; ","type":"text"},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/stabilizedPosition","isActive":true,"type":"reference"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"time-filtered variant that trades a little latency for much less jitter. Prefer","type":"text"},{"text":" ","type":"text"},{"text":"the stabilized position for cursors and UI hit-testing, and the raw position for","type":"text"},{"text":" ","type":"text"},{"text":"physical simulation.","type":"text"}]},{"anchor":"Fingers-and-Bones","text":"Fingers and Bones","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Each "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger","isActive":true,"type":"reference"},{"type":"text","text":" exposes its four bones from the wrist outward, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/bones"},{"type":"text","text":" returns them in that order."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/tipPosition"},{"type":"text","text":" is a shortcut for the distal bone’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/nextJoint"},{"type":"text","text":" — the fingertip."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the Ultraleap skeletal model the thumb has no true metacarpal bone."},{"type":"text","text":" "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/metacarpal","isActive":true,"type":"reference"},{"type":"text","text":" is still present for the thumb, but it is zero-length,"},{"type":"text","text":" "},{"type":"text","text":"so "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/length","isActive":true,"type":"reference"},{"type":"text","text":" returns "},{"code":"0","type":"codeVoice"},{"type":"text","text":" and "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/center","isActive":true,"type":"reference"},{"type":"text","text":" coincides with both joints."},{"type":"text","text":" "},{"type":"text","text":"Skip it when drawing, or you will render a degenerate segment."}]}],"type":"aside","style":"note"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone"},{"type":"text","text":" is a segment between two joints: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/previousJoint"},{"type":"text","text":" toward the"},{"type":"text","text":" "},{"type":"text","text":"wrist, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/nextJoint"},{"type":"text","text":" toward the fingertip. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/center"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/length"},{"type":"text","text":" are derived from those, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Bone\/width"},{"type":"text","text":" estimates the flesh"},{"type":"text","text":" "},{"type":"text","text":"around the bone in millimeters — enough to size a capsule mesh."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["for finger in hand.fingers {","    for bone in finger.bones where bone.length > 0 {","        drawCapsule(from: bone.previousJoint,","                    to: bone.nextJoint,","                    radius: bone.width * 0.5,","                    rotation: bone.rotation)","    }","}"]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/isExtended"},{"type":"text","text":" reports whether the finger is roughly straight, which is"},{"type":"text","text":" "},{"type":"text","text":"the simplest basis for counting fingers or recognizing static poses:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let extended = hand.fingers.filter(\\.isExtended).count"]}]}],"kind":"article","variants":[{"paths":["\/documentation\/leapswift\/handmodel"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://org.studiomexx.LeapSwift/documentation/LeapSwift/Finger/isExtended":{"type":"topic","url":"\/documentation\/leapswift\/finger\/isextended","abstract":[{"text":"Whether the finger is extended (roughly straight).","type":"text"}],"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Finger\/isExtended","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isExtended","kind":"identifier"},{"text":": ","kind":"text"},{"