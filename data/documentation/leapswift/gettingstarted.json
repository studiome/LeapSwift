":"async throws"},{"text":". It throws a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapError","type":"reference"},{"text":" if the connection to the service cannot be created or opened —","type":"text"},{"text":" ","type":"text"},{"text":"most often because the Ultraleap Hand Tracking service is not running.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import LeapSwift","","let controller = try await LeapController(trackingMode: .desktop)"]},{"inlineContent":[{"text":"The tracking mode is applied once the service reports a connection, so there is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"no need to wait for "},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapEvent\/connected","type":"reference","isActive":true},{"text":" before setting it. To change it","type":"text"},{"type":"text","text":" "},{"text":"later, call ","type":"text"},{"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/setTrackingMode(_:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Consume Events","anchor":"Consume-Events"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/events","isActive":true},{"type":"text","text":" is an "},{"type":"codeVoice","code":"AsyncStream"},{"text":" you can iterate from any task. The","type":"text"},{"text":" ","type":"text"},{"text":"stream carries connection lifecycle events alongside tracking frames, so a","type":"text"},{"text":" ","type":"text"},{"text":"single loop can drive both your UI state and your hand rendering.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let task = Task {","    for await event in controller.events {","        switch event {","        case .connect