pEvent\/connected"},{"type":"text","text":" before setting it. To change it"},{"type":"text","text":" "},{"type":"text","text":"later, call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/setTrackingMode(_:)"},{"type":"text","text":"."}]},{"level":3,"type":"heading","text":"Consume Events","anchor":"Consume-Events"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/events","type":"reference"},{"text":" is an ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" you can iterate from any task. The","type":"text"},{"text":" ","type":"text"},{"text":"stream carries connection lifecycle events alongside tracking frames, so a","type":"text"},{"text":" ","type":"text"},{"text":"single loop can drive both your UI state and your hand rendering.","type":"text"}],"type":"paragraph"},{"code":["let task = Task {","    for await event in controller.events {","        switch event {","        case .connected:","            status = \"Connected\"","        case .disconnected:","            status = \"Service unavailable\"","        case .deviceFound:","            status = \"Device ready\"","        case .deviceLost:","            status = \"Device unplugged\"","        case .trackingFrame(let frame):","            render(frame)","        case .error(let error):","            log(error.localizedDescription)","        @unknown default:","            break","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapEvent"},{"type":"text","text":" is not "},{"type":"codeVoice","code":"@frozen"},{"text":", so a ","type":"text"},{"code":"switch","type":"codeVoice"},{"type":"text","text":" outside the fra