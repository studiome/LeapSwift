{"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"modules":[{"name":"LeapSwift"}],"roleHeading":"Article","role":"article","title":"Getting Started"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"LeapSwift has one entry point: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController"},{"type":"text","text":". Creating it opens a"},{"type":"text","text":" "},{"type":"text","text":"connection to the Ultraleap service and starts a background polling loop;"},{"type":"text","text":" "},{"text":"consuming ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/events","type":"reference"},{"text":" delivers everything that loop observes.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Create a Controller","anchor":"Create-a-Controller","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/init(trackingMode:mock:mockScenario:)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"async throws"},{"type":"text","text":". It throws a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapError"},{"type":"text","text":" if the connection to the service cannot be created or opened —"},{"type":"text","text":" "},{"type":"text","text":"most often because the Ultraleap Hand Tracking service is not running."}],"type":"paragraph"},{"syntax":"swift","code":["import LeapSwift","","let controller = try await LeapController(trackingMode: .desktop)"],"type":"codeListing"},{"inlineContent":[{"text":"The tracking mode is applied once the service reports a connection, so there is","type":"text"},{"text":" ","type":"text"},{"text":"no need to wait for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapEvent\/connected","type":"reference"},{"text":" before setting it. To change it","type":"text"},{"text":" ","type":"text"},{"text":"later, call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/setTrackingMode(_:)","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Consume Events","anchor":"Consume-Events","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/events","type":"reference"},{"text":" is an ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":" you can iterate from any task. The","type":"text"},{"text":" ","type":"text"},{"text":"stream carries connection lifecycle events alongside tracking frames, so a","type":"text"},{"text":" ","type":"text"},{"text":"single loop can drive both your UI state and your hand rendering.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let task = Task {","    for await event in controller.events {","        switch event {","        case .connected:","            status = \"Connected\"","        case .disconnected:","            status = \"Service unavailable\"","        case .deviceFound:","            status = \"Device ready\"","        case .deviceLost:","            status = \"Device unplugged\"","        case .trackingFrame(let frame):","            render(frame)","        case .error(let error):","            log(error.localizedDescription)","        @unknown default:","            break","        }","    }","}"],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapEvent"},{"type":"text","text":" is not "},{"type":"codeVoice","code":"@frozen"},{"type":"text","text":", so a "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" outside the framework needs"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"codeVoice","code":"@unknown default"},{"type":"text","text":". "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/HandType"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/VersionPart"},{"type":"text","text":" are frozen and switch"},{"type":"text","text":" "},{"type":"text","text":"exhaustively without one."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"inlineContent":[{"text":"Failures raised while the controller is handling an event cannot be thrown to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"you, so they arrive as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapEvent\/error(_:)"},{"text":". The controller keeps running: it","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"stays connected and retries opening a device on the next "},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapEvent\/connected"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapEvent\/deviceFound(_:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you only care about hand data, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/frames"},{"text":" maps the stream to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"HandFrame?"},{"text":", emitting ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" for non-tracking events:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["for await frame in controller.frames {","    guard let frame else { continue }","    render(frame)","}"]},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"text":"The stream is unicast. Iterating ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/events"},{"text":" from two","type":"text"},{"text":" ","type":"text"},{"text":"places splits the events between them rather than duplicating them. To fan out","type":"text"},{"text":" ","type":"text"},{"text":"to multiple consumers, iterate once and rebroadcast.","type":"text"}],"type":"paragraph"}]},{"anchor":"Detect-a-Gesture","type":"heading","level":3,"text":"Detect a Gesture"},{"inlineContent":[{"type":"text","text":"Pinch and grab are reported per hand as normalized strengths, which is usually"},{"type":"text","text":" "},{"type":"text","text":"easier to work with than raw joint positions."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["for await frame in controller.frames {","    guard let hand = frame?.rightHand else { continue }","","    if hand.grabStrength > 0.8 {","        beginDrag(at: hand.palm.position)","    } else if hand.pinchStrength > 0.9 {","        select(at: hand.index.tipPosition)","    }","}"]},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/palm"},{"text":" also exposes ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/stabilizedPosition"},{"text":", a time-filtered position","type":"text"},{"text":" ","type":"text"},{"text":"that is better suited to pointing at 2D UI than the raw","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Palm\/position","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/isPinching","type":"reference"},{"text":" reflects the service’s own gesture flag, which","type":"text"},{"text":" ","type":"text"},{"text":"requires a gesture detection license. Without one it stays ","type":"text"},{"type":"codeVoice","code":"false"},{"type":"text","text":"; compare"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/pinchStrength"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/Hand\/pinchDistance"},{"type":"text","text":" against a threshold instead."}],"type":"paragraph"}]},{"anchor":"Inspect-the-Device","type":"heading","level":3,"text":"Inspect the Device"},{"inlineContent":[{"text":"Device details become available once a device has been opened, which happens","type":"text"},{"text":" ","type":"text"},{"text":"automatically after ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapEvent\/connected"},{"text":". Before that,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/deviceInfo()"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["if let info = await controller.deviceInfo() {","    print(\"Serial: \\(info.serialNumber)\")","    print(\"FOV: \\(info.horizontalFOV) × \\(info.verticalFOV)\")","}","","let version = try await controller.version(of: .serverLibrary)","print(\"Service v\\(version.major).\\(version.minor).\\(version.patch)\")"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Shut-Down","text":"Shut Down"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/stop()"},{"text":" cancels polling, finishes the event stream — which","type":"text"},{"text":" ","type":"text"},{"text":"ends any ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":" loop over it — and closes the device and connection.","type":"text"},{"text":" ","type":"text"},{"code":"deinit","type":"codeVoice"},{"text":" performs the same teardown, so stopping explicitly is only necessary","type":"text"},{"text":" ","type":"text"},{"text":"when you want tracking to end before the controller is released.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["await controller.stop()"]},{"inlineContent":[{"text":"Calling ","type":"text"},{"isActive":true,"identifier":"doc:\/\/org.studiomexx.LeapSwift\/documentation\/LeapSwift\/LeapController\/stop()","type":"reference"},{"text":" more than once is safe. After stopping, the","type":"text"},{"text":" ","type":"text"},{"text":"controller cannot be reconnected; create a new one instead.","type":"text"}],"type":"paragraph"},{"anchor":"Starting-Without-a-Device","type":"heading","level":3,"text":"Starting Without a Device"},{"inlineContent":[{"type":"text","text":"Everything above needs the Ultraleap service and a physical device. If you"},{"type":"text","text":" "},{"type":"text","text":"don’t have either handy — or want deterministic data for a demo or a test —"},{"type":"text","text":" "},{"type":"text","text":"pass "},{"type":"codeVoice","code":"mock: .always"},{"text":" and get the exact same event stream from synthetic hand","type":"text"},{"text":" ","type":"text"},{"text":"data instead:","type":"text"}],"type":"pa